#!/usr/bin/env python3
"""Öffnet vlc://open?url=<http-Link> in VLC (für die TNAS-Weboberfläche).
Nur http(s)-Links auf einen /stream/-Pfad werden weitergegeben – andere Webseiten können darüber nichts starten."""
import subprocess, sys, urllib.parse
arg = sys.argv[1] if len(sys.argv) > 1 else ""
q = urllib.parse.urlsplit(arg)
url = urllib.parse.parse_qs(q.query).get("url", [""])[0]
u = urllib.parse.urlsplit(url)
if q.scheme != "vlc" or u.scheme not in ("http", "https") or not u.path.startswith("/stream/"):
    subprocess.run(["notify-send", "VLC-Link abgelehnt", "Nur Stream-Links der TNAS-Oberfläche werden geöffnet."])
    sys.exit(1)
subprocess.Popen(["vlc", "--started-from-file", "--", url], start_new_session=True,
                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
